generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Course {
  id               Int                @id @default(autoincrement())
  code             String             @db.Char(6)
  title            String             @db.VarChar(100)
  type             CourseType
  yearLevel        Int                @map("year_level") @db.TinyInt
  schedules        CourseSchedule[]

  @@unique([code, title], map: "uq_courses_code_title")
  @@map("courses")
}

model CourseSchedule {
  id            Int                             @id @default(autoincrement())
  courseId      Int                             @map("course_id")
  section       Int                             @db.UnsignedTinyInt
  startWeek     Int                             @map("start_week") @db.TinyInt
  endWeek       Int                             @map("end_week") @db.TinyInt
  dayOfWeek     ScheduleDayOfWeek               @map("day_of_week")
  startTime     DateTime                        @map("start_time") @db.Time(0)
  endTime       DateTime                        @map("end_time") @db.Time(0)
  room          String?                         @db.VarChar(20)
  studentGroup  ScheduleStudentGroup?           @map("student_group")
  remarks       String?                         @db.VarChar(255)
  course        Course                          @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_schedule_course")

  @@index([courseId], map: "fk_schedule_course")
  @@map("courses_schedule")
}

enum CourseType {
  CORE
  ELECTIVE
}

enum ScheduleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleStudentGroup {
  A
  B
}

model AcademicSetting {
  id                  Int    @id
  currentAcademicYear Int    @map("current_academic_year")
  currentSemester     Int    @map("current_semester")
  programCode         String @map("program_code") @db.Text
  programName         String @map("program_name") @db.Text

  @@map("academic_settings")
}

model StudentGroupRange {
  id           Int    @id @default(autoincrement())
  entryYear    Int    @map("entry_year")
  studentGroup String @map("student_group") @db.VarChar(1)
  fromNo       Int    @map("from_no")
  toNo         Int    @map("to_no")

  @@map("student_group_ranges")
}

model Selection {
  studentId String   @map("student_id")
  courseId  Int      @map("course_id")
  section   Int
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([studentId, courseId])
  @@map("selections")
}
